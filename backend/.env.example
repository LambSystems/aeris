# Optional LLM keys. Aeris still works without these because fallback advice is deterministic.
AERIS_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=

# Optional CV settings.
YOLO_MODEL_PATH=
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_IMAGE_SIZE=640
YOLO_INCLUDE_ALL_CLASSES=true
YOLO_LABEL_ALIASES_PATH=

# Streamlit live scanner.
YOLO_IMGSZ=320
YOLO_FRAME_SKIP=2
YOLO_DEVICE=
AERIS_ADVICE_COOLDOWN=10
AERIS_CAMERA_WIDTH=640
AERIS_CAMERA_HEIGHT=360
AERIS_CAMERA_FPS=20
AERIS_PUBLIC_STREAMLIT_URL=http://127.0.0.1:8507
